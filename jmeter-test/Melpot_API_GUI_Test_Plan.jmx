                <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments">
                    <elementProp name="" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">false</boolProp>
                      <stringProp name="Argument.value">{
  "type": "${__chooseRandom(STATUS,MEDIA,QUOTES,CHECKIN,AUDIO)}",
  "media": "",
  "entertainment_id": "",
  "entertainment_type": "",
  "status_id": "",
  "place_id": "",
  "quotes": "${__chooseRandom(Life is beautiful,Testing with JMeter,Hello world,Great day today,API load testing)}",
  "address": "",
  "location": "",
  "latitude": "",
  "longitude": "",
  "source_type": "",
  "media_name": "",
  "description": "JMeter Load Test Post - ${__time(yyyy-MM-dd HH:mm:ss)} - Thread: ${__threadNum} - Random: ${__Random(1000,9999)}",
  "tagged_user": "",
  "itunes_url": "",
  "allow_anonymous_comment": "${__chooseRandom(0,1)}",
  "privacy": "${__chooseRandom(public,private)}",
  "keep_post": "",
  "ent_media": "",
  "ent_title": "",
  "ent_description": "",
  "audioUrl": ""
}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                    </elementProp>
                  </collectionProp>
                </elementProp>
