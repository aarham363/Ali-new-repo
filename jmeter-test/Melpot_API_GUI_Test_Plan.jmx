              <stringProp name="Header.name">access_token</stringProp>
              <stringProp name="Header.value">${__property(GLOBAL_ACCESS_TOKEN)}</stringProp>
            </elementProp>
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">X-Forwarded-For</stringProp>
              <stringProp name="Header.value">${__Random(1,255)}.${__Random(1,255)}.${__Random(1,255)}.${__Random(1,255)}</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>

        <!-- Weighted Random Controller for User Behavior -->
        <RandomController guiclass="RandomControlGui" testclass="RandomController" testname="User Behavior Simulation" enabled="true">
          <stringProp name="TestPlan.comments">Simulates realistic user behavior with weighted API operations</stringProp>
        </RandomController>
        <hashTree>
          <!-- Feed Browsing (40% weight) -->
          <ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="Feed Browsing (40%)" enabled="true">
            <intProp name="ThroughputController.style">1</intProp>
            <boolProp name="ThroughputController.perThread">false</boolProp>
            <intProp name="ThroughputController.maxThroughput">1</intProp>
            <stringProp name="ThroughputController.percentThroughput">40.0</stringProp>
            <stringProp name="TestPlan.comments">Users browsing home feed and profile feeds</stringProp>
          </ThroughputController>
          <hashTree>
            <RandomController guiclass="RandomControlGui" testclass="RandomController" testname="Random Feed Operation" enabled="true"/>
            <hashTree>
              <!-- Home Post List -->
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Get Home Feed" enabled="true">
                <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments">
                    <elementProp name="" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">false</boolProp>
                      <stringProp name="Argument.value">{"page": ${__Random(1,5)}, "limit": ${__Random(10,25)}}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                    </elementProp>
                  </collectionProp>
                </elementProp>
                <stringProp name="HTTPSampler.domain"></stringProp>
                <stringProp name="HTTPSampler.port"></stringProp>
                <stringProp name="HTTPSampler.protocol"></stringProp>
                <stringProp name="HTTPSampler.contentEncoding"></stringProp>
                <stringProp name="HTTPSampler.path">/api/v2/feed/home_post_list</stringProp>
                <stringProp name="HTTPSampler.method">POST</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
                <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
                <stringProp name="HTTPSampler.connect_timeout"></stringProp>
                <stringProp name="HTTPSampler.response_timeout"></stringProp>
              </HTTPSamplerProxy>
              <hashTree>
                <!-- Extract Post IDs for later use -->
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract Post IDs" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">POST_ID</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExpr">$.data.result[*].id</stringProp>
                  <stringProp name="JSONPostProcessor.defaultValues">default_post_id</stringProp>
                  <stringProp name="JSONPostProcessor.var_name"></stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExpr_2"></stringProp>
                  <stringProp name="JSONPostProcessor.defaultValues_2"></stringProp>
                  <stringProp name="JSONPostProcessor.var_name_2"></stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExpr_3"></stringProp>
                  <stringProp name="JSONPostProcessor.defaultValues_3"></stringProp>
                  <stringProp name="JSONPostProcessor.var_name_3"></stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExpr_4"></stringProp>
                  <stringProp name="JSONPostProcessor.defaultValues_4"></stringProp>
                  <stringProp name="JSONPostProcessor.var_name_4"></stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExpr_5"></stringProp>
                  <stringProp name="JSONPostProcessor.defaultValues_5"></stringProp>
                  <stringProp name="JSONPostProcessor.var_name_5"></stringProp>
                  <boolProp name="JSONPostProcessor.compute_concat">true</boolProp>
                </JSONPostProcessor>
                <hashTree/>
              </hashTree>

              <!-- Profile Post List -->
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Get Profile Posts" enabled="true">
                <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments">
